# --- Modo ---------------------------------------------------------------
# paper = corretor simulado com dados sintéticos (por omissão, sem risco)
# mt5   = MetaTrader 5 real através do Expert Advisor mt5/MTAI_Bridge.mq5
MTAI_MODE=paper

# Em modo mt5 as ordens só são enviadas quando isto for true. Comece numa conta DEMO.
MTAI_TRADING_ENABLED=false

# Segredo partilhado com o Expert Advisor (obrigatório em modo mt5)
MTAI_BRIDGE_TOKEN=

# Símbolos (nomes sem sufixo do corretor; o sufixo VT Markets configura-se no EA)
MTAI_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD,XAGUSD

# Servidor
HOST=127.0.0.1
PORT=8787

# Simulação: milissegundos reais por vela M15 simulada
MTAI_SIM_CANDLE_MS=2000

# --- IA (opcional) ------------------------------------------------------
# Sem chave, os agentes usam regras determinísticas.
ANTHROPIC_API_KEY=
MTAI_LLM_MODEL=claude-opus-5-5

# Feeds RSS de notícias (modo mt5), separados por vírgula
MTAI_NEWS_FEEDS=https://www.fxstreet.com/rss/news
