# --- Modo ---------------------------------------------------------------
# paper = corretor simulado com dados sintéticos (por omissão, sem risco)
# mt5   = MetaTrader 5 real através do Expert Advisor mt5/MTAI_Bridge.mq5
MTAI_MODE=paper

# Em modo mt5 as ordens só são enviadas quando isto for true. Comece numa conta DEMO.
MTAI_TRADING_ENABLED=false

# Segredo partilhado com o Expert Advisor (obrigatório em modo mt5)
MTAI_BRIDGE_TOKEN=

# Símbolos (nomes sem sufixo do corretor; o sufixo VT Markets configura-se no EA)
MTAI_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD,XAGUSD

# Servidor
HOST=127.0.0.1
PORT=8787

# Simulação: milissegundos reais por vela M15 simulada
MTAI_SIM_CANDLE_MS=2000

# --- IA (opcional) ------------------------------------------------------
# Sem chave, os agentes usam regras determinísticas.
ANTHROPIC_API_KEY=
MTAI_LLM_MODEL=claude-opus-5-5

# Feeds RSS de notícias (modo mt5), separados por vírgula
MTAI_NEWS_FEEDS=https://www.fxstreet.com/rss/news

# --- Login e acesso remoto ----------------------------------------------
# Ligação Postgres do Neon (use o endereço "pooled", com sslmode=require).
# Com isto definido, o painel e a API exigem login. Sem isto, o servidor só
# aceita arrancar em 127.0.0.1.
DATABASE_URL=

# Primeiro arranque: cria este operador se a base de dados ainda não tiver nenhum.
# Depois de entrar uma vez, apague MTAI_ADMIN_PASSWORD.
MTAI_ADMIN_EMAIL=
MTAI_ADMIN_PASSWORD=

# Origem do painel quando está noutro domínio (por exemplo no Vercel).
MTAI_ALLOWED_ORIGINS=https://mtbot.dev

# Número de proxies inversos à frente do servidor (1 se usar Caddy, nginx ou
# Cloudflare Tunnel), para o limite de pedidos ver o IP verdadeiro.
MTAI_TRUST_PROXY=0

# true quando o servidor é servido por HTTPS.
MTAI_HSTS=false

# No Vercel (variável de build do painel): endereço público do servidor.
# VITE_API_URL=https://api.mtbot.dev
